NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mecook?schema=public
JWT_SECRET=replace-with-long-random-secret
APP_BASE_URL=https://mecook.app
MEDIA_UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:8081,https://mecook.app
TRUST_PROXY=true
PUSH_ENABLED=true
PUSH_BATCH_SIZE=100
PUSH_BATCH_DELAY_MS=100
